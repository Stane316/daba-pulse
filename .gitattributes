# DabaPulse — normalize line endings across Windows / macOS / Linux
# Repository stores LF; Windows checkouts can convert to CRLF locally.
* text=auto eol=lf
# Explicit source / config
*.py    text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.jsx   text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.toml  text eol=lf
*.txt   text eol=lf
*.csv   text eol=lf
*.svg   text eol=lf
*.sh    text eol=lf
*.env.example text eol=lf
# Windows scripts may keep CRLF if added later
*.ps1   text eol=crlf
*.bat   text eol=crlf
*.cmd   text eol=crlf
# Binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.pdf   binary
*.docx  binary
*.woff  binary
*.woff2 binary
*.ttf   binary