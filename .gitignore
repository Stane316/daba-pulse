**/.cache/

# ============================================================
# 5. PYTHON — BACKEND / DATA / AI
# ============================================================

# Python cache
__pycache__/
**/__pycache__/

*.py[cod]
*$py.class

# Python build artifacts
build/
dist/
*.egg-info/
*.egg
.eggs/

# Virtual environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Python tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.tox/
.nox/

# Coverage
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover

# Packaging
pip-wheel-metadata/

