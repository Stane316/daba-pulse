*.mp4
*.mov
*.avi
*.mkv

# Local audio
*.mp3
*.wav
*.m4a

# Local large images
*.psd
*.ai
*.raw

# ============================================================
# 21. DABAPULSE-SPECIFIC PROTECTION
# ============================================================

# Real DABA data must never be committed accidentally
data/daba/
data/daba-real/
data/daba-production/

# Real business exports
data/business/
data/production/

# Synthetic data is allowed to be versioned.
# Keep synthetic datasets outside the ignored directories above.

# Local dashboard exports
dashboard-exports/
dashboard_exports/

# Local analytics exports
analytics-exports/
analytics_exports/

# Local decision-engine outputs
decision-outputs/
decision_outputs/

# Local simulation results
simulation-results/
simulation_results/

# ============================================================
# 22. LOCAL DOCUMENTS CONTAINING PRIVATE INFORMATION
# ============================================================

# Personal working documents
private/
_private/
personal/
_personal/

# Team-private working material
team-private/
team_private/

# ============================================================
# 23. MISCELLANEOUS
# ============================================================

# OS/browser temporary files
*.stackdump

# Lock files generated by some tools
*.lock

# Local history
.history/

# Temporary patch files
*.patch
*.rej

# ============================================================
# END — DabaPulse .gitignore
# ============================================================