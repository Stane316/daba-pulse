# ============================================================
# DabaPulse — Global Git Ignore
# ============================================================
# Purpose:
# - Protect secrets and credentials
# - Prevent personal/sensitive data from being committed
# - Ignore local development artifacts
# - Ignore generated files and dependencies
# - Keep the repository clean and reproducible
# ============================================================


# ============================================================
# 1. ENVIRONMENT VARIABLES & SECRETS
# ============================================================

.env
.env.*
!.env.example

# Local environment overrides
.env.local
.env.development.local
.env.test.local
.env.production.local

# Secret/config files
*.secret
*.secrets
secrets/
.secret/
.credentials/
credentials/

# API keys / tokens / private configuration
*.pem
*.key
*.crt
*.p12
*.pfx

# Service account credentials
service-account*.json
service_account*.json
*-credentials.json
*-service-account.json

# Firebase / Google credentials
firebase-adminsdk*.json
google-credentials*.json

# ============================================================
# 2. PERSONAL & SENSITIVE DATA
# ============================================================

# Real customer/user datasets
data/raw/
data/private/
data/personal/
data/confidential/
data/customer/
data/customers/
data/users/
data/clients/

# Personally identifiable information
**/*pii*
**/*PII*
**/*personal-data*
**/*personal_data*
**/*sensitive-data*
**/*sensitive_data*
**/*confidential*

# Real exports
**/*customer-export*
**/*customer_export*
**/*user-export*
**/*user_export*
**/*client-export*
**/*client_export*

# Contact information exports
**/*contacts*.csv
**/*contacts*.xlsx
**/*contacts*.json

# Transaction/customer exports
**/*orders*.csv
**/*orders*.xlsx
**/*orders*.json
**/*transactions*.csv
**/*transactions*.xlsx
**/*transactions*.json

# Logs that may contain personal information
*.log
logs/

# ============================================================
# 3. DATASET PROTECTION
# ============================================================

# Large/raw datasets
data/raw/
data/private/
data/external/
data/downloaded/

# Generated datasets
data/generated/
data/processed/
data/interim/
data/cache/

# Local experimentation
data/tmp/
data/temp/

# Database dumps
*.sql
*.sql.gz
*.dump
*.bak

# Local database files
*.db
*.sqlite
*.sqlite3

