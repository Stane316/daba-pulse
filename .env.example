# DabaPulse — Environment variables (example)
# Copy to .env and fill values. Never commit real secrets.
# Backend
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=*
DATA_PATH=../data/sample
# ---------------------------------------------------------------------------
# AI Layer (optional) — OpenAI-compatible API
# The product works WITHOUT any key (deterministic fallback).
# Recommended free/cheap path for demo: OpenRouter
# ---------------------------------------------------------------------------
AI_ENABLED=true
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=openai/gpt-4o-mini
# Alternatives (examples — set BASE_URL + MODEL accordingly):
# OpenAI official:
#   OPENAI_BASE_URL=https://api.openai.com/v1
#   OPENAI_MODEL=gpt-4o-mini
# xAI Grok (OpenAI-compatible):
#   OPENAI_BASE_URL=https://api.x.ai/v1
#   OPENAI_MODEL=grok-2-latest
# Google Gemini via OpenRouter is often simpler than native Gemini SDK.
# Frontend (Vite)
# Leave empty in local dev to use Vite proxy /api -> :8000
VITE_API_URL=

