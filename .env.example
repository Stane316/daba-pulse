# DabaPulse — Environment variables (example)
# Copy to .env and fill values. Never commit real secrets.

# Backend
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=*
DATA_PATH=../data/sample

# OpenAI-compatible LLM (optional — app works without it)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
AI_ENABLED=true

# Frontend (Vite)
VITE_API_URL=http://localhost:8000
